{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "ask",
      "CLAUDE.md": "deny",
      "AGENTS.md": "deny",
      ".claude/*": "deny",
      ".claude/**": "deny",
      ".opencode/*": "deny",
      ".opencode/**": "deny",
      "opencode.json": "deny",
      ".githooks/*": "deny",
      "tools/ai/*": "deny",
      "Code/Dynamic_War_Manager/Source/Test/baseline/*": "deny"
    },
    "bash": {
      "*": "ask",
      "git push*": "deny",
      "git stash*": "deny",
      "git worktree*": "deny",
      "git config*": "deny",
      "pip*": "deny",
      "pip3*": "deny",
      "*pip install*": "deny",
      "*-m pip *": "deny",
      "sudo*": "deny",
      "apt*": "deny",
      "apt-get*": "deny",
      "*git push*": "deny",
      "*git branch -d*": "deny",
      "*git branch -D*": "deny",
      "*git branch -m*": "deny",
      "*git branch -M*": "deny",
      "*git branch --delete*": "deny",
      "*git branch --move*": "deny"
    }
  },
  "agent": {
    "oc-ui-developer": {
      "disable": true
    }
  }
}
